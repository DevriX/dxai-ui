{
  "name": "devrix/dxai-ui",
  "description": "Figma/Lovable to Gutenberg WordPress plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "DXAI_UI\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.2.29"
    },
    "sort-packages": true
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "phpcompatibility/php-compatibility": "^10.0@alpha",
    "phpstan/phpstan": "^2.3",
    "squizlabs/php_codesniffer": "^3.13",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "scripts": {
    "lint": "node bin/lint.cjs",
    "phpcs": "phpcs",
    "phpstan": "phpstan analyse --memory-limit=2G --no-progress",
    "check": [
      "@lint",
      "@phpcs",
      "@phpstan"
    ]
  },
  "scripts-descriptions": {
    "lint": "Every PHP file and plain script parses (bin/lint.cjs).",
    "phpcs": "The gate: security, prepared SQL, translations, PHP 8.2+ (phpcs.xml.dist).",
    "phpstan": "Static analysis at level 5; only problems not in phpstan-baseline.neon fail.",
    "check": "The three static checks CI runs."
  }
}
